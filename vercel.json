{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/wtf"
    },
    {
      "source": "/race-control-7f3c",
      "destination": "/index.html"
    },
    {
      "source": "/wtf",
      "destination": "/api/wtf"
    },
    {
      "source": "/wtf/",
      "destination": "/api/wtf"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/api/wtf"
    }
  ]
}
